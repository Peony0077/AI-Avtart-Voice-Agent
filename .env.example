# Copy to .env and adjust. Every setting can also be overridden with AVATAR_* env vars
# (nested keys use "__", e.g. AVATAR_LLM__MAX_TOKENS=200). The environment wins over this file.
#
# Profile: default | avatar | avatar_clone | clone | lite (config/profiles/<name>.yaml)
AVATAR_PROFILE=default
#
# Where the model weights live (outside the repo), and the Hugging Face cache inside it.
# Unset, they default to E:/AI-models (Windows) or ~/AI-models (Linux). Examples:
#   Windows:  AVATAR_MODEL_HOME=E:/AI-models      HF_HOME=E:/AI-models/hf
#   Linux:    AVATAR_MODEL_HOME=/home/<you>/AI-models   HF_HOME=/home/<you>/AI-models/hf
# (absolute paths: "~" is not expanded here)
#AVATAR_MODEL_HOME=
#HF_HOME=
