* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.pdf binary
*.docx binary

# shell scripts keep LF even on a Windows checkout (bash cannot read CRLF)
*.sh text eol=lf
