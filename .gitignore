# =============================================================================
# AI Avatar Voice Agent - .gitignore
# Model/weight folder names are ignored at ANY depth (vendored avatar code keeps
# weights in ./models). Therefore no source package may be named "models",
# "weights", "checkpoints" or "cache" (use "schemas", "engines", ...).
# =============================================================================

# ---- Secrets & local config -------------------------------------------------
.env
.env.*
!.env.example
*.local
/certs/
*.pem
*.key
*.crt
*.pfx

# ---- Python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---- Node / Vite ------------------------------------------------------------
node_modules/
dist/
coverage/
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/tests/e2e/results/
/playwright-report/
/test-results/

# ---- Model weights, checkpoints & caches (never commit) --------------------
models/
weights/
checkpoints/
cache/
.cache/
hf_cache/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.engine
*.trt
*.plan
*.npy
*.npz
*.pkl

# ---- Third-party runtimes / vendored code fetched by scripts ----------------
/tools/llama.cpp/
/avatar/*/vendor/
*.exe
*.dll

# ---- Data (private documents, generated indexes, personal likeness) ---------
/data/*
!/data/README.md

# ---- Large generated media --------------------------------------------------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.flac
*.mp3
*.ogg
*.m4a
!tests/fixtures/**

# ---- Runtime output ---------------------------------------------------------
logs/
*.log
/recordings/
/tmp/
*.tmp
*.prof
*.nsys-rep

# ---- Editors & tools --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
.claude/settings.local.json

# ---- OS ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
tests/e2e/results/
