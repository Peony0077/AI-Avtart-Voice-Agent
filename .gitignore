# =============================================================================
# AI Avatar Voice Agent - .gitignore
# Project-specific paths are root-anchored ("/models/") on purpose, so they
# don't also hide source folders such as backend/app/models/ or src/lib/.
# =============================================================================

# ---- Secrets & local config -------------------------------------------------
.env
.env.*
!.env.example
*.local
# Dev HTTPS certificates (needed for mic access from other devices)
/certs/
*.pem
*.key
*.crt
*.pfx

# ---- Python -----------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---- Node / Vite frontend ---------------------------------------------------
node_modules/
/frontend/dist/
/frontend/coverage/
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Model weights & caches (download via scripts, never commit) -----------
/models/
/hf_cache/
/.cache/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.onnx
*.engine
*.trt
*.plan

# ---- Third-party runtimes (e.g. prebuilt llama.cpp) --------------------------
/tools/llama.cpp/
*.exe
*.dll

# ---- RAG data ---------------------------------------------------------------
# Generated vector indexes / DBs
/data/index/
/data/cache/
# Source documents may be private or large: opt-in by removing this line
/data/knowledge/

# ---- Runtime output ---------------------------------------------------------
/logs/
*.log
/recordings/
/debug_audio/
/tmp/
*.tmp
*.prof
*.nsys-rep

# ---- Editors & tools --------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
.claude/settings.local.json

# ---- OS ---------------------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store
